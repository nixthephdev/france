  "components": [
    {
      "name": "Reading action",
      "kind": "button",
      "refersTo": "reading-action",
      "description": "Primary reading link followed by visible preview disclosure, grouped after the cover summary.",
      "html": "<div class=\"ds-cover-actions\"><a class=\"ds-reading\" href=\"/insights/meaningful-growth\">Preview essay <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a><p class=\"ds-preview-status\">Editorial preview</p></div>",
      "css": ".ds-cover-actions{display:flex;align-items:center;flex-wrap:wrap;gap:16px 24px;margin-top:30px}.ds-cover-actions .ds-reading{margin-top:0}.ds-preview-status{font-family:var(--font-body,'Hanken Grotesk',sans-serif);display:inline-block;margin:0;color:var(--accent-ink,#66501e);font-size:17px;font-weight:500}.ds-reading{font-family:var(--font-body, 'Hanken Grotesk', sans-serif);display:inline-flex;align-items:center;justify-content:space-between;gap:32px;min-height:60px;padding:13px 28px;border-radius:15px;background:var(--accent,#dfc47e);color:var(--foreground,#173e46);font-size:23px;font-weight:600;line-height:1.4;text-decoration:none;transition:background-color 180ms var(--ease-out,cubic-bezier(.2,.7,.2,1)),transform 180ms var(--ease-out,cubic-bezier(.2,.7,.2,1))}.ds-reading:hover{background:#d3b368;transform:translateY(-2px)}.ds-reading:focus-visible{outline:2px solid var(--foreground,#173e46);outline-offset:5px;border-radius:2px}@media(max-width:640px){.ds-reading{min-height:52px;font-size:18px;gap:25px;padding:12px 23px;border-radius:12px}}@media(prefers-reduced-motion:reduce){.ds-reading{transition:none}}@media(max-width:640px){.ds-cover-actions{gap:12px 18px;margin-top:24px}.ds-preview-status{font-size:15px}}"
    },
    {
      "name": "Publication masthead",
      "kind": "nav",
      "description": "Publication name, byline and quiet desktop navigation; the separate sheet handles mobile.",
      "html": "<header class=\"ds-masthead\"><a class=\"ds-brand\" href=\"/\" aria-label=\"France ? home\"><span class=\"ds-brand-name\">France</span><span class=\"ds-byline\">Olga France Blas-Obias</span></a><nav class=\"ds-desktop\" aria-label=\"Main navigation\"><a class=\"ds-nav-link\" href=\"/insights\">Insights</a><a class=\"ds-nav-link\" href=\"/#about\">About</a><a class=\"ds-nav-link\" href=\"/#speaking\">Speaking</a><a class=\"ds-nav-link\" href=\"/#projects\">Projects</a><a class=\"ds-nav-link\" href=\"/#connect\">Contact</a></nav></header>",
      "css": ".ds-masthead{font-family:var(--font-body, 'Hanken Grotesk', sans-serif);color:var(--foreground,#173e46);display:flex;align-items:center;justify-content:space-between;gap:32px;min-height:108px}.ds-brand{display:grid;color:inherit;text-decoration:none;flex-shrink:0}.ds-brand-name{font-size:48px;font-weight:600;line-height:1;letter-spacing:-.035em}.ds-byline{font-size:16px;line-height:1.7;letter-spacing:-.015em}.ds-desktop{display:flex;gap:34px;align-items:center}.ds-nav-link{display:inline-flex;align-items:center;min-height:44px;font-size:18px;color:inherit;text-decoration:none;border-bottom:1px solid transparent;transition:border-color 160ms var(--ease-out,cubic-bezier(.2,.7,.2,1))}.ds-nav-link:hover{border-color:var(--foreground,#173e46)}.ds-nav-link:focus-visible{outline:2px solid var(--foreground,#173e46);outline-offset:5px;border-radius:2px}.ds-brand:focus-visible{outline:2px solid var(--foreground,#173e46);outline-offset:5px;border-radius:2px}@media(max-width:1100px){.ds-desktop{gap:24px}.ds-nav-link{font-size:16px}.ds-brand-name{font-size:40px}.ds-byline{font-size:14px}}@media(max-width:850px){.ds-desktop{display:none}.ds-masthead{min-height:96px}}@media(max-width:640px){.ds-masthead{min-height:86px;gap:15px}.ds-brand-name{font-size:33px}.ds-byline{font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none}}"
    },
    {
      "name": "Topic index",
      "kind": "nav",
      "description": "Ruled homepage index with four columns, reducing to two at 850px.",
      "html": "<nav class=\"ds-index\" aria-label=\"Explore insights by topic\"><a class=\"ds-topic\" href=\"/insights?topic=entrepreneurship\">Entrepreneurship<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a><a class=\"ds-topic\" href=\"/insights?topic=business-strategy\">Business strategy<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a><a class=\"ds-topic\" href=\"/insights?topic=sustainability\">Sustainability<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a><a class=\"ds-topic\" href=\"/insights?topic=mentorship\">Mentorship<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a></nav>",
      "css": ".ds-index{font-family:var(--font-body, 'Hanken Grotesk', sans-serif);display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-block:1px solid #b99a50;color:var(--foreground,#173e46)}.ds-topic{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px 20px 15px 0;min-height:74px;font-size:23px;font-weight:500;letter-spacing:-.025em;color:inherit;text-decoration:none;transition:color 160ms var(--ease-out,cubic-bezier(.2,.7,.2,1))}.ds-topic:hover{color:#735c27}.ds-topic svg{flex-shrink:0}.ds-topic:focus-visible{outline:2px solid var(--foreground,#173e46);outline-offset:5px;border-radius:2px}@media(max-width:1100px){.ds-topic{font-size:20px;padding-right:16px}}@media(max-width:850px){.ds-index{grid-template-columns:repeat(2,minmax(0,1fr))}.ds-topic{min-height:64px;font-size:22px}.ds-topic:nth-child(-n+2){border-bottom:1px solid var(--line,#b9cdcb)}}@media(max-width:640px){.ds-topic{min-height:63px;font-size:18px;padding-right:15px;gap:8px}.ds-topic svg{width:15px;height:15px}}@media(prefers-reduced-motion:reduce){.ds-topic{transition:none}}"
    },
    {
      "name": "Topic filter links",
      "kind": "chip",
      "refersTo": "filter-link",
      "description": "Query-string navigation with aria-current selected state; no toggle or input behavior.",
      "html": "<nav class=\"ds-filters\" aria-label=\"Filter insights by topic\"><a class=\"ds-filter\" href=\"/insights\" aria-current=\"page\">All topics</a><a class=\"ds-filter\" href=\"/insights?topic=sustainability\">Sustainability</a><a class=\"ds-filter\" href=\"/insights?topic=mentorship\">Mentorship</a></nav>",
      "css": ".ds-filters{font-family:var(--font-body, 'Hanken Grotesk', sans-serif);display:flex;flex-wrap:wrap;gap:10px;margin:30px 0 10px}.ds-filter{display:inline-flex;align-items:center;min-height:44px;padding:8px 17px;border:1px solid var(--line,#b9cdcb);border-radius:24px;font-size:16px;color:var(--foreground,#173e46);text-decoration:none}.ds-filter:hover{background:var(--surface,#e0ece9)}.ds-filter[aria-current=page]{background:var(--foreground,#173e46);color:var(--background,#f5f8f7);border-color:var(--foreground,#173e46)}.ds-filter:focus-visible{outline:2px solid var(--foreground,#173e46);outline-offset:5px;border-radius:2px}@media(max-width:640px){.ds-filters{gap:8px;margin-top:24px}.ds-filter{padding:8px 13px;font-size:14px}}"
    },
    {
      "name": "Insight row",
      "kind": "custom",
      "description": "Content comes first in the DOM; desktop grid places metadata alongside it, while mobile shows metadata below the reading action.",
      "html": "<article class=\"ds-row\"><div class=\"ds-row-copy\"><h3 class=\"ds-title\"><a class=\"ds-title-link\" href=\"/insights/meaningful-growth\">What does meaningful growth look like?</a></h3><p class=\"ds-summary\">Looking beyond the next milestone to the kind of business we want to build.</p><a class=\"ds-text-link\" href=\"/insights/meaningful-growth\">Read preview <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a></div><p class=\"ds-meta\">Business strategy<span class=\"ds-preview\">Editorial preview</span></p></article>",
      "css": ".ds-row{font-family:var(--font-body, 'Hanken Grotesk', sans-serif);display:grid;grid-template-columns:minmax(150px,.75fr) minmax(0,3fr);gap:50px;padding-block:33px;border-block:1px solid var(--line,#b9cdcb);color:var(--foreground,#173e46)}.ds-meta{margin:0;color:var(--text-secondary,#436168);font-size:15px;line-height:1.65}.ds-preview{display:block;font-size:13px;margin-top:5px}.ds-title{margin:0;max-width:27ch;font-size:clamp(28px,3vw,39px);font-weight:500;line-height:1.12;letter-spacing:-.035em;text-wrap:balance}.ds-title-link{color:inherit;text-decoration:none;text-underline-offset:.25em}.ds-title-link:hover{text-decoration:underline;text-decoration-thickness:1px}.ds-summary{margin:14px 0 0;max-width:65ch;color:var(--text-secondary,#436168);font-size:18px;line-height:1.65}.ds-text-link{display:inline-flex;align-items:center;gap:18px;min-height:44px;margin-top:16px;color:inherit;font-size:17px;font-weight:500;text-decoration:none;text-underline-offset:.25em}.ds-text-link:hover{text-decoration:underline}.ds-title-link:focus-visible{outline:2px solid var(--foreground,#173e46);outline-offset:5px;border-radius:2px}.ds-text-link:focus-visible{outline:2px solid var(--foreground,#173e46);outline-offset:5px;border-radius:2px}@media(max-width:1100px){.ds-row{gap:32px}}@media(max-width:640px){.ds-row{grid-template-columns:1fr;gap:15px;padding-block:26px}.ds-meta{font-size:14px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.ds-preview{margin-top:0}.ds-title{font-size:29px;line-height:1.17}.ds-summary{font-size:17px}.ds-text-link{font-size:16px;margin-top:13px}}.ds-row>.ds-row-copy{grid-column:2;grid-row:1}.ds-row>.ds-meta{grid-column:1;grid-row:1}@media(max-width:640px){.ds-row>.ds-row-copy,.ds-row>.ds-meta{grid-column:auto;grid-row:auto}}"
    },
